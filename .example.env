# Шаблон переменных окружения для Vite.
# Скопируйте в .env.development (dev) или .env.production (build) и перезапустите `npm run dev`.
#
# Правила:
# - только ключи с префиксом VITE_ попадают в клиентский бандл;
# - значения всегда строки в файле, тип задаётся в src/shared/lib/env/config.ts;
# - доступ в коде: import { env } from '@shared/lib/env'

# Базовый URL API (обязательно, string). Пример: https://dummyjson.com/products
VITE_API_DOMAIN=https://dummyjson.com

# Тестовое число (обязательно, number)
VITE_TEST_NUMBER=7

# Тестовый флаг (обязательно, boolean: true | false | 1 | 0 | yes | no)
VITE_TEST_BOOLEAN=true

# Опциональная строка (необязательно; если не нужна — закомментируйте или удалите)
# VITE_TEST_UNDEFINED=
